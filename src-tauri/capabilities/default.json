{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Penna reads and writes in the home and Documents folders, where the Penna library lives, and in any folder picked in the dialog. persisted-scope keeps picked folders across restarts.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-ask",
    "core:window:allow-destroy",
    "fs:allow-read-text-file",
    "fs:allow-mkdir",
    "fs:allow-write-text-file",
    "fs:allow-rename",
    "fs:allow-read-dir",
    "fs:allow-stat",
    "fs:allow-exists",
    "fs:allow-watch",
    "fs:allow-unwatch",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME"
        },
        {
          "path": "$HOME/**"
        },
        {
          "path": "$DOCUMENT"
        },
        {
          "path": "$DOCUMENT/**"
        }
      ]
    }
  ]
}
