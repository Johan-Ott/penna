{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The folder the user picks in the dialog is added to the fs scope by the dialog plugin.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-ask",
    "core:window:allow-destroy",
    "fs:allow-read-text-file",
    "fs:allow-mkdir",
    "fs:allow-write-text-file",
    "fs:allow-rename",
    "fs:allow-read-dir",
    "fs:allow-stat",
    "fs:allow-exists",
    "fs:allow-watch",
    "fs:allow-unwatch"
  ]
}
