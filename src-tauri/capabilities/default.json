{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Penna reads and writes in the home and Documents folders, where the Penna library lives, and in any folder picked in the dialog. Exports are saved where the save dialog says. persisted-scope keeps picked folders across restarts.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-ask",
    "dialog:allow-save",
    "core:window:allow-destroy",
    "fs:allow-read-text-file",
    "process:allow-restart",
    "updater:default",
    "opener:allow-reveal-item-in-dir",
    "notification:default",
    "fs:allow-read-file",
    "fs:allow-mkdir",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-rename",
    "fs:allow-read-dir",
    "fs:allow-stat",
    "fs:allow-exists",
    "fs:allow-watch",
    "fs:allow-unwatch",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME"
        },
        {
          "path": "$HOME/**"
        },
        {
          "path": "$DOCUMENT"
        },
        {
          "path": "$DOCUMENT/**"
        }
      ]
    }
  ]
}
