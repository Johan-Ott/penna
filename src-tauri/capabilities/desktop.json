{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "On a computer the Penna library lives in the home or Documents folder, or in any folder picked in the dialog; persisted-scope keeps picked folders across restarts. Updates come from GitHub Releases.",
  "platforms": ["windows", "macOS", "linux"],
  "windows": ["main"],
  "permissions": [
    "updater:default",
    "core:window:allow-destroy",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME"
        },
        {
          "path": "$HOME/**"
        },
        {
          "path": "$DOCUMENT"
        },
        {
          "path": "$DOCUMENT/**"
        }
      ]
    }
  ]
}
