{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "On a computer the Skrivro library lives in Documents or in OneDrive, Dropbox or iCloud Drive in the home folder, or in any folder picked in the dialog (kept by persisted-scope); the rest of the home folder is out of reach; its automatic copies in backups/ in Skrivro's own folder; persisted-scope keeps picked folders across restarts. Updates come from GitHub Releases. The text's own menu reads the clipboard for Klistra in. A research file in a book's filer/ folder opens in its own program. The window has no frame, so Skrivro's top bar moves, minimises, maximises and closes it.",
  "platforms": ["windows", "macOS", "linux"],
  "windows": ["main"],
  "permissions": [
    "updater:default",
    "clipboard-manager:allow-read-text",
    "core:window:allow-destroy",
    "core:window:allow-minimize",
    "core:window:allow-show",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "**/*.skrivro/filer/*" },
        { "path": "**/*.penna/filer/*" },
        { "path": "**/*.serie/filer/*" }
      ]
    },
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME/OneDrive"
        },
        {
          "path": "$HOME/OneDrive/**"
        },
        {
          "path": "$HOME/Dropbox"
        },
        {
          "path": "$HOME/Dropbox/**"
        },
        {
          "path": "$HOME/iCloudDrive"
        },
        {
          "path": "$HOME/iCloudDrive/**"
        },
        {
          "path": "$HOME/Library/Mobile Documents/com~apple~CloudDocs"
        },
        {
          "path": "$HOME/Library/Mobile Documents/com~apple~CloudDocs/**"
        },
        {
          "path": "$DOCUMENT"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$APPDATA/backups"
        },
        {
          "path": "$APPDATA/backups/**"
        },
        {
          "path": "$APPDATA/Dokument"
        },
        {
          "path": "$APPDATA/Dokument/**"
        }
      ]
    }
  ]
}
